# SERVER
HOST_SERVER=127.0.0.1
PORT_SERVER=8000
# Comma-separated origins or a one-line JSON array.
ORIGINS=http://localhost:5173,http://localhost:3000

# GOOGLE SIGN IN: Web application OAuth client ID
GOOGLE_CLIENT_ID=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypt billing account numbers: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this key stable; existing card numbers require the original key.
ENCRYPTION_KEY=

# POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DATABASE_NAME=finance_tracker
# Enable TLS with certificate verification for hosted PostgreSQL (e.g. Neon).
DB_SSL=false
