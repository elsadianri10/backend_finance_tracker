# SERVER
HOST_SERVER=127.0.0.1
PORT_SERVER=8000
# Comma-separated origins or a one-line JSON array.
ORIGINS=http://localhost:5173,http://localhost:3000

# GOOGLE SIGN IN: Web application OAuth client ID
GOOGLE_CLIENT_ID=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypt billing account numbers: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this key stable; existing card numbers require the original key.
ENCRYPTION_KEY=

# POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DATABASE_NAME=finance_tracker
# Enable TLS with certificate verification for hosted PostgreSQL (e.g. Neon).
DB_SSL=false

# Passkey production configuration (frontend origin, not backend URL)
WEBAUTHN_RP_ID=frontend-finance-tracker-ecru.vercel.app
WEBAUTHN_ORIGINS=https://frontend-finance-tracker-ecru.vercel.app
# Local testing uses RP localhost with origin http://localhost:3000 instead.

# Wishlist uploads: token from a PRIVATE Vercel Blob store, backend only.
BLOB_READ_WRITE_TOKEN=

# Admin authority is stored in users.admin_f after migration 031.
# ACCESS_ADMIN_EMAILS is obsolete and no longer grants access.

# Midtrans: backend-only. Start with Sandbox; enable only after migration 028.
MIDTRANS_ENABLED=false
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
# Random URL-safe secret for BOTH Payment and Recurring Notification URLs; never expose to browser.
MIDTRANS_WEBHOOK_TOKEN=
# Enable only after Midtrans activates card recurring / GoPay tokenization, recurring and No PIN.
MIDTRANS_RECURRING_ENABLED=false
SUBSCRIPTION_FRONTEND_URL=http://localhost:3000

# Separate 32-byte hex key for encrypted database backup files; keep outside backups/Git.
BACKUP_ENCRYPTION_KEY=
# Optional PostgreSQL client binaries directory
PG_BIN=C:/Program Files/PostgreSQL/16/bin
